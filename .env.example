# Copie para .env e preencha. Nunca versione o .env.

# Token de app privado do HubSpot (Fase 2 em diante)
HUBSPOT_TOKEN=
# Client secret do app do HubSpot, usado para validar a assinatura v3 do webhook
HUBSPOT_WEBHOOK_SECRET=
# URL pública exata cadastrada no HubSpot (necessária atrás de proxy/Cloud Run,
# pois a assinatura inclui a URL). Ex.: https://seu-dominio/webhooks/hubspot
WEBHOOK_URL_PUBLICA=
# Janela máxima, em segundos, entre o timestamp do HubSpot e o recebimento
JANELA_ASSINATURA_SEGUNDOS=300
# Versões de assinatura aceitas: v3 (com timestamp), v1 (webhook de app),
# v2 (ação de webhook de workflow, só planos Pro/Enterprise)
ASSINATURAS_ACEITAS=v3,v1

DATABASE_URL=postgresql+psycopg2://leads:leads@localhost:5432/leads

# Nomes das propriedades de contato no HubSpot (ajuste para cada conta)
PROPRIEDADE_EMAIL=email
PROPRIEDADE_CNPJ=cnpj
PROPRIEDADE_ORIGEM=origem_enriquecimento
PROPRIEDADE_DATA=data_enriquecimento
# Campo interno -> propriedade de contato (JSON). Campos fora do mapa só vão
# para a auditoria. Quando duas fontes trazem a mesma propriedade, vence a
# maior confiança. Campos disponíveis:
#   BrasilAPI: razao_social, nome_fantasia, cnae_principal, situacao_cadastral,
#              porte, municipio, uf, cep, endereco
#   Apollo:    nome_empresa, site, linkedin_empresa, setor, num_funcionarios,
#              receita_anual, ano_fundacao, descricao, endereco, municipio, uf,
#              cep, pais
MAPA_PROPRIEDADES={"razao_social":"company","municipio":"city","uf":"state","cep":"zip","endereco":"address","cnae_principal":"industry","nome_empresa":"company","site":"website","setor":"industry","pais":"country"}
# Abaixo desta confiança nada é gravado automaticamente
CONFIANCA_MINIMA=0.70

# Fonte paga por domínio (Fase 3). Preset "apollo" (padrão): basta ligar a flag,
# preencher a chave e o limite. Preset "personalizado": qualquer provedor HTTP
# JSON, com URL e mapa de campos obrigatórios. Toda variável PROVEDOR_DOMINIO_*
# abaixo, se definida, sobrescreve o preset; deixe comentada para usar o preset.
FONTE_DOMINIO_ATIVA=false
PROVEDOR_DOMINIO_PRESET=apollo
# Apollo: chave com acesso a api/v1/organizations/enrich (ou master key)
PROVEDOR_DOMINIO_API_KEY=
# Consultas por mês (UTC). Na Apollo, 1 consulta = 1 crédito. Ao atingir, a
# fonte é pulada e o motivo registrado. Ajuste ao plano contratado.
LIMITE_CONSUMO_MENSAL_PROVEDOR=1000
# Confiança dos campos do provedor (CNPJ exato = 1.00; abaixo de CONFIANCA_MINIMA não grava)
PROVEDOR_DOMINIO_CONFIANCA=0.85
# --- sobrescritas opcionais do preset ---
# Nome da fonte na auditoria, em origem_enriquecimento e nas métricas
# PROVEDOR_DOMINIO_NOME=apollo
# URL de consulta com o marcador {dominio}
# PROVEDOR_DOMINIO_URL=https://api.apollo.io/api/v1/organizations/enrich?domain={dominio}
# Header de autenticação e prefixo do valor (ex.: Authorization com "Bearer ")
# PROVEDOR_DOMINIO_HEADER_AUTH=x-api-key
# PROVEDOR_DOMINIO_PREFIXO_AUTH=
# Campo interno -> caminho na resposta JSON (pontos para aninhar, número para lista).
# Para gravar no HubSpot, o campo interno também precisa estar em MAPA_PROPRIEDADES.
# PROVEDOR_DOMINIO_MAPA_CAMPOS={"nome_empresa":"organization.name","setor":"organization.industry"}
# Caminho na resposta com a confiança do provedor (0 a 1); vale a menor
# PROVEDOR_DOMINIO_CAMINHO_CONFIANCA=
# Limite de taxa: no máximo LIMITE_TAXA chamadas por JANELA_TAXA_SEGUNDOS
# (Apollo: 600 por hora no exemplo da documentação; varia por plano)
# PROVEDOR_DOMINIO_LIMITE_TAXA=600
# PROVEDOR_DOMINIO_JANELA_TAXA_SEGUNDOS=3600

# Token para GET /metricas (Authorization: Bearer <token>). Vazio = sem autenticação.
METRICAS_TOKEN=

MAX_TENTATIVAS=5
WORKER_INTERVALO_SEGUNDOS=5
WORKER_TAMANHO_LOTE=10
WORKER_RESERVA_SEGUNDOS=600
LOG_LEVEL=INFO
